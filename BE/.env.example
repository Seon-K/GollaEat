# BE/.env is auto-loaded; existing process environment variables take precedence.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECRET_KEY=django-insecure-local-development-only
CATALOG_MENU_CSV=
# Optional final dataset override; keep CSV files outside the repository.
CATALOG_FINAL_CSV=
CATALOG_USE_DB=true
# Disabled by default. Select a provider only after team approval; keep the key outside Git.
CATALOG_GEOCODER=catalog.geocoding.Geocoder
CATALOG_GEOCODER_API_KEY=
CATALOG_GEOCODER_TIMEOUT=5
CATALOG_COORDINATE_VALIDATION_CSV=
CATALOG_RESTAURANT_CSV=
# Supabase PostgreSQL connection URI; configure the real value outside Git.
DATABASE_URL=
DJANGO_CSRF_TRUSTED_ORIGINS=
SQLITE_PATH=
CATALOG_FRANCHISE_COORDINATE_CSV=
CATALOG_ASAN_COORDINATE_CSV=
GEMINI_API_KEY=
KAKAO_LOCAL_REST_API_KEY=