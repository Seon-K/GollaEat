# These values must be set as environment variables; .env is not auto-loaded.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECRET_KEY=django-insecure-local-development-only
CATALOG_MENU_CSV=
CATALOG_RESTAURANT_CSV=
# Supabase PostgreSQL connection URI; configure the real value outside Git.
DATABASE_URL=
DJANGO_CSRF_TRUSTED_ORIGINS=
SQLITE_PATH=
CATALOG_FRANCHISE_COORDINATE_CSV=
CATALOG_ASAN_COORDINATE_CSV=
